{
  "name": "tofa",
  "module": "src/index.tsx",
  "description": "A light, local-first, encrypted 2FA code vault.",
  "homepage": "https://tofa.ribaunt.com",
  "author": {
    "name": "Ribaunt",
    "email": "support@ribaunt.com"
  },
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ribaunt/tofa.git"
  },
  "keywords": [
    "2FA",
    "TOTP",
    "vault"
  ],
  "bin": {
    "tofa": "./dist/tofa"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build --compile src/index.tsx --outfile dist/tofa",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "prepublish": "bun run build && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.2.2",
    "@opentui/keymap": "^0.2.2",
    "@opentui/react": "0.2.2",
    "ink": "^7.0.1",
    "react": "^19.2.4"
  }
}